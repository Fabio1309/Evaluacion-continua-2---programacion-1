@model IEnumerable<EC2_PROGRA1.Models.Inmueble>
@using EC2_PROGRA1.Models

@{
    ViewData["Title"] = "Catálogo de Inmuebles";
}

<h1>@ViewData["Title"]</h1>
<hr />

<!-- FORMULARIO DE FILTROS -->
<form asp-action="Catalogo" method="get" class="mb-4">
    <h4>Filtros</h4>
    <!-- Muestra los errores de validación del controlador -->
    <div asp-validation-summary="All" class="text-danger"></div>
    
    <div class="row">
        <div class="col-md-3">
            <div class="form-group">
                <label>Ciudad</label>
                <input type="text" name="ciudad" value="@ViewBag.Ciudad" class="form-control" />
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <label>Tipo de Inmueble</label>
                <select name="tipo" asp-items="Html.GetEnumSelectList<TipoInmueble>()" class="form-control">
                    <option value="">Todos</option>
                </select>
            </div>
        </div>
        <div class="col-md-2">
            <div class="form-group">
                <label>Precio Mín.</label>
                <input type="number" name="precioMin" value="@ViewBag.PrecioMin" class="form-control" min="0" />
            </div>
        </div>
        <div class="col-md-2">
            <div class="form-group">
                <label>Precio Máx.</label>
                <input type="number" name="precioMax" value="@ViewBag.PrecioMax" class="form-control" min="0" />
            </div>
        </div>
        <div class="col-md-2">
            <div class="form-group">
                <label>Dormitorios >=</label>
                <input type="number" name="dormitorios" value="@ViewBag.Dormitorios" class="form-control" min="0" />
            </div>
        </div>
    </div>
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Filtrar</button>
        <a asp-action="Catalogo" class="btn btn-secondary">Limpiar Filtros</a>
    </div>
</form>

<hr />

<!-- LISTADO DE INMUEBLES -->
<div class="row">
    @if (!Model.Any())
    {
        <div class="col">
            <p>No se encontraron inmuebles con los filtros seleccionados.</p>
        </div>
    }
    else
    {
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card">
                    <img src="@item.Imagen" class="card-img-top" alt="Imagen de @item.Titulo" style="height: 200px; object-fit: cover;">
                    <div class="card-body">
                        <h5 class="card-title">@item.Titulo</h5>
                        <p class="card-text">@item.Ciudad - @item.Tipo</p>
                        <p class="card-text"><strong>Precio:</strong> @item.Precio.ToString("C0")</p>
                        <ul class="list-unstyled">
                            <li>@item.MetrosCuadrados m² | @item.Dormitorios dorm. | @item.Banos baño(s)</li>
                        </ul>
                        <!-- Este botón nos llevará a la página de detalle que crearemos a continuación -->
                        <a asp-action="Detalle" asp-route-id="@item.Id" class="btn btn-info">Ver Detalle</a>

                    </div>
                </div>
            </div>
        }
    }
</div>